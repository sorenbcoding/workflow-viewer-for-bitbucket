{
  "name": "workflow-viewer-for-bitbucket",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only canvas view of UiPath workflows inside Bitbucket Cloud.",
  "license": "MIT",
  "author": "Søren Schytz Birk",
  "repository": "github:sorenbcoding/workflow-viewer-for-bitbucket",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sorenb/dev-harness",
    "test": "npm test -w @sorenb/xaml-core",
    "typecheck": "tsc -p packages/xaml-core && tsc -p packages/xaml-render && tsc -p apps/dev-harness && tsc -p apps/forge-app",
    "build:forge": "npm run build -w @sorenb/forge-app",
    "brand-check": "python %USERPROFILE%/.claude/skills/sorenb-brand/scripts/brand_check.py . --category app"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "prosemirror-view": "^1.42.9"
  }
}
