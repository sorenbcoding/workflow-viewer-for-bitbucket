<Activity mc:Ignorable="sap sap2010" x:Class="CalculateTotals" sap2010:ExpressionActivityEditor.ExpressionActivityEditor="C#" sap2010:WorkflowViewState.IdRef="ActivityBuilder_1" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mca="clr-namespace:Microsoft.CSharp.Activities;assembly=System.Activities" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_Lines" Type="InArgument(scg:List(x:Decimal))" />
    <x:Property Name="out_Total" Type="OutArgument(x:Decimal)" />
  </x:Members>
  <Sequence DisplayName="Calculate Totals" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:ForEach x:TypeArguments="x:Decimal" CurrentIndex="{x:Null}" DisplayName="For Each line" sap2010:WorkflowViewState.IdRef="ForEach`1_1">
      <ui:ForEach.Values>
        <InArgument x:TypeArguments="scg:IEnumerable(x:Decimal)">
          <mca:CSharpValue x:TypeArguments="scg:IEnumerable(x:Decimal)">in_Lines</mca:CSharpValue>
        </InArgument>
      </ui:ForEach.Values>
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:Decimal">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Decimal" Name="line" />
          </ActivityAction.Argument>
          <Assign DisplayName="Add line" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Decimal">
                <mca:CSharpReference x:TypeArguments="x:Decimal">out_Total</mca:CSharpReference>
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Decimal">
                <mca:CSharpValue x:TypeArguments="x:Decimal">out_Total + line</mca:CSharpValue>
              </InArgument>
            </Assign.Value>
          </Assign>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <While DisplayName="While total is negative" sap2010:WorkflowViewState.IdRef="While_1">
      <While.Condition>
        <mca:CSharpValue x:TypeArguments="x:Boolean">out_Total &lt; 0</mca:CSharpValue>
      </While.Condition>
      <Assign DisplayName="Reset total" sap2010:WorkflowViewState.IdRef="Assign_2">
        <Assign.To>
          <OutArgument x:TypeArguments="x:Decimal">
            <mca:CSharpReference x:TypeArguments="x:Decimal">out_Total</mca:CSharpReference>
          </OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:Decimal">0</InArgument>
        </Assign.Value>
      </Assign>
    </While>
  </Sequence>
</Activity>
